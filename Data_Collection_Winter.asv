plot3DBarFeatures(strength_levels, pump_speed_sweep, PumpFlow_Max_Matrix,  'Peak Pump Flow (/min)', folder_3D);
plot3DBarFeatures(strength_levels, pump_speed_sweep, dPumpFlow_Matrix,     'Flow Pulsatility (dQF)', folder_3D);
plot3DBarFeatures(strength_levels, pump_speed_sweep, dPumpFlow_Max_Matrix, 'Peak Flow Pulsatility (dQF)', folder_3D);
plot3DBarFeatures(strength_levels, pump_speed_sweep, DeltaPumpP_Matrix,    'Delta Simualation Pump Pressure (mmHg)', folder_3D);
plot3DBarFeatures(strength_levels, pump_speed_sweep, PumpP_Mean_Matrix,    'Mean Simulation Pump Pressure (mmHg)', folder_3D);
